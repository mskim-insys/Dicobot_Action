# ==========================================
# 디스코드 통합 알리미 환경 설정 예시
# ==========================================

# ------------------------------------------
# 1. 디스코드 웹훅 설정 (채널별 분리 완벽 지원)
# ------------------------------------------
# [공통 기본 웹훅] 아래 전용 웹훅이 비어있으면 모든 알림이 이 주소로 전송됩니다.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# [채널별 개별 분리 웹훅 (선택 사항)]
# 각각 다른 디스코드 채널로 받고 싶다면 아래에 채널별 웹훅을 채워넣으세요.
DISCORD_KONEPS_WEBHOOK_URL=    # 나라장터 공고 전용 채널 (#나라장터-공고)
DISCORD_NEWS_WEBHOOK_URL=      # 테크 뉴스 전용 채널 (#테크-트렌드 또는 긱뉴스)
DISCORD_HN_WEBHOOK_URL=        # 해커뉴스 전용 채널 (비워두면 DISCORD_NEWS_WEBHOOK_URL 사용)
DISCORD_ARXIV_WEBHOOK_URL=     # AI / CV 최신 논문 전용 채널 (#논문-브리핑)
DISCORD_OPENAI_WEBHOOK_URL=    # OpenAI News RSS 전용 채널
DISCORD_SIMON_WILLISON_WEBHOOK_URL= # Simon Willison 블로그 전용 채널
DISCORD_LOBSTERS_WEBHOOK_URL=  # Lobsters RSS 전용 채널

# ------------------------------------------
# 2. 나라장터 알리미 설정
# ------------------------------------------
DATA_GO_KR_API_KEY=your_public_data_portal_api_key_here
TARGET_KEYWORDS=비전,머신비전,AI,인공지능,딥러닝,스마트,스마트팩토리,데이터,검사기,소프트웨어,SW
ENABLE_PRICE_FILTER=false
MIN_PRICE=50000000
MAX_PRICE=1000000000
LOOKBACK_DAYS=1

# ------------------------------------------
# 3. 테크 뉴스 (긱뉴스) 설정
# ------------------------------------------
GEEKNEWS_LIMIT=5
# NEWS_KEYWORDS=AI,비전,LLM  # 특정 키워드 포함 글만 필터링 (비워두면 최신순 전체)

# ------------------------------------------
# 4. 추가 RSS/Atom 뉴스 피드
# ------------------------------------------
OPENAI_LIMIT=5
SIMON_WILLISON_LIMIT=5
LOBSTERS_LIMIT=5
# OPENAI_KEYWORDS=AI,API
# SIMONWILLISON_KEYWORDS=LLM,Python
# LOBSTERS_KEYWORDS=AI,security

# ------------------------------------------
# 5. 글로벌 테크 뉴스 (Hacker News) 설정
# ------------------------------------------
HN_LIMIT=5          # 전송할 최대 개수 (기본 5개)
HN_MIN_SCORE=50     # 최소 추천(포인트) 수 (점수가 50점 이상인 검증된 핫 트렌드만 수집)
# HN_KEYWORDS=AI,vision,agent,llm  # 키워드 필터링 (비워두면 인기순 전체)

# ------------------------------------------
# 6. Arxiv AI/컴퓨터 비전 논문 브리핑 설정
# ------------------------------------------
ARXIV_LIMIT=5
# ARXIV_KEYWORDS=vision,yolo,segment,multimodal,diffusion,agent,llm  # 비워두면 최신순 전체

# ------------------------------------------
# 7. 로컬 주기적 자동 실행 제어
# ------------------------------------------
INTERVAL_MINUTES=
