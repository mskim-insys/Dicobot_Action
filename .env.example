# ==========================================
# 디스코드 통합 알리미 환경 설정 예시
# ==========================================

# 1. 공통 디스코드 웹훅 URL (필수)
# 디스코드 채널 설정 -> 연동 -> 웹후크 -> URL 복사
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# (선택) 뉴스 전용 채널로 따로 받고 싶을 때만 입력 (비워두면 위의 DISCORD_WEBHOOK_URL로 통합 전송)
DISCORD_NEWS_WEBHOOK_URL=

# ------------------------------------------
# [나라장터 알리미 설정]
# ------------------------------------------
# 공공데이터포털 API 인증키 (https://www.data.go.kr - 조달청 나라장터 입찰공고정보서비스)
DATA_GO_KR_API_KEY=your_public_data_portal_api_key_here

# 필터링 키워드 (쉼표 구분)
TARGET_KEYWORDS=비전,머신비전,AI,인공지능,딥러닝,스마트,스마트팩토리,데이터,검사기,소프트웨어,SW

# 금액 필터 사용 여부 (false: 모든 금액 / true: 아래 금액 구간 적용)
ENABLE_PRICE_FILTER=false
MIN_PRICE=50000000
MAX_PRICE=1000000000

# 조회 기간 (기본값: 1 = 어제~오늘)
LOOKBACK_DAYS=1

# ------------------------------------------
# [뉴스 알리미 설정] (기획서 확정 후 추가)
# ------------------------------------------
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# ------------------------------------------
# [공통 실행 제어]
# ------------------------------------------
# 로컬 주기적 반복 실행 간격 (단위: 분, 비워두거나 0이면 1회만 실행 후 종료)
INTERVAL_MINUTES=
