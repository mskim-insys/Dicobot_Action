# ==========================================
# 나라장터 디스코드 알리미 환경 설정 예시
# ==========================================

# 1. 공공데이터포털 API 인증키 (Encoding 키 또는 Decoding 키 중 아무거나 입력)
# 발급처: https://www.data.go.kr (조달청 나라장터 입찰공고정보서비스)
DATA_GO_KR_API_KEY=your_public_data_portal_api_key_here

# 2. 디스코드 웹훅 URL
# 디스코드 채널 설정 -> 연동(Integrations) -> 웹후크(Webhooks) -> '새 웹후크' 생성 후 URL 복사
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# 3. 필터링 키워드 (쉼표로 구분)
TARGET_KEYWORDS=비전,머신비전,AI,인공지능,딥러닝,스마트,스마트팩토리,데이터,검사기,소프트웨어,SW

# 4. 금액 필터 사용 여부 (false: 금액 상관없이 모든 공고 알림 / true: 아래 금액 구간 적용)
ENABLE_PRICE_FILTER=false

# 금액 필터 구간 (ENABLE_PRICE_FILTER=true 일 때만 적용, 단위: 원)
MIN_PRICE=50000000
MAX_PRICE=1000000000

# 5. 조회 기간 (과거 며칠 전부터 오늘까지 조회할지, 기본값: 1 = 어제~오늘)
LOOKBACK_DAYS=1

# 6. 로컬 주기적 반복 실행 간격 (단위: 분, 비워두거나 0이면 1회만 실행 후 종료)
INTERVAL_MINUTES=


